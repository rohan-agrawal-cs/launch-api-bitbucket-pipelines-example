# For local runs only. Copy to .env and fill in your values:
#   cp .env.example .env && npm run deploy
# In Bitbucket these are set as Repository variables instead -- never commit .env.

# M2M app credentials (Developer Hub -> your app -> Authentication -> M2M)
CONTENTSTACK_CLIENT_ID="your_client_id"
CONTENTSTACK_CLIENT_SECRET="your_client_secret"

# One of: AWS_NA, AWS_EU, AWS_AU, AZURE_NA, AZURE_EU, GCP_NA, GCP_EU
# (DEV11 targets the Contentstack-internal non-production stack.)
CONTENTSTACK_REGION="AWS_NA"

# For a stack the region list does not cover, set both of these instead of
# CONTENTSTACK_REGION. Hostnames only -- a full URL is accepted and trimmed.
# CONTENTSTACK_AUTH_HOST="stag-app.csnonprod.com"
# CONTENTSTACK_LAUNCH_API_HOST="stag-launch-api.csnonprod.com"

# The existing Launch project and environment to redeploy
PROJECT_UID="your_project_uid"
ENVIRONMENT_UID="your_environment_uid"

# Optional -----------------------------------------------------------------
# By default the whole working directory is uploaded, minus VCS metadata,
# node_modules, framework caches (.next, .nuxt, .turbo, coverage, ...) and any
# .env file (.env.example is kept). Add more exclusions by name:
# LAUNCH_EXCLUDE="fixtures,docs"

# Or upload only these top-level entries instead of scanning the directory:
# LAUNCH_INCLUDE="package.json,package-lock.json,src,public"

# Set to false to queue the deployment and exit without waiting for it.
# WAIT_FOR_DEPLOYMENT="true"

# How long to wait for a terminal deployment status (default 900).
# DEPLOYMENT_TIMEOUT_SECONDS="900"
